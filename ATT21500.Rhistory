####Comandos Base####
#Limpiar espacio
rm(list=ls())
#Librerias requeridas
library(readxl)
library(robust)
library(MASS)
#Directorio Insumos
#setwd("/Users/nngc/Ministerio de Minas y Energía/LUISA FERNANDA GARCIA VANEGAS - Proyectos Especiales/Resol Met 40403 de 2021/Modelo MME/EDS")#Importar base de datos
#setwd("/Users/nngc/Library/CloudStorage/OneDrive-Bibliotecascompartidas:MinisteriodeMinasyEnergía/LUISA FERNANDA GARCIA VANEGAS - Proyectos Especiales/Resol Met. 40412 de 2021/Modelo MME/EDS")#Importar base de datos
#setwd("/Users/nngc/Library/CloudStorage/OneDrive-Bibliotecascompartidas:MinisteriodeMinasyEnergía/LUISA FERNANDA GARCIA VANEGAS - Proyectos Especiales/Resol Met. 40412 de 2021/Modelo MME/EDS")#Importar base de datos
setwd("C:/Users/josel/Desktop/Ministerio de Minas y Energia/40. Información metodología ZDF/1. Revisión CUPO OCTUBRE 2024/BASE R")
#/Users/nngc/Library/CloudStorage/OneDrive-Bibliotecascompartidas:MinisteriodeMinasyEnergía/LUISA FERNANDA GARCIA VANEGAS - Proyectos Especiales/Resol Met. 40412 de 2021/Modelo MME/EDS
Base=read_xlsx("InsumoExcel_riosucio.xlsx", sheet = "Insumo R")
#####
#### Volumen Distribuido por Compras - VDC ####
#1.
Base$BVA = Base$VDP
#2.
Base$ICBV = (Base$Xcompras/Base$BVA)
Base$ICBV[is.na(Base$ICBV)] <- 0
Base$ICBV[is.infinite(Base$ICBV)] <- 0
#3.
Base$FA = rep(0,length(Base$ICBV))
for (i in 1:length(Base$ICBV)) {
if (Base$ICBV[i]>=1){Base$FA[i]=(1/(Base$MO[i] - Base$MC[i] +2))}else{
if (Base$ICBV[i]<1){Base$FA[i]=Base$ICBV[i]}}}
#4.
Base$FE = rep(0,length(Base$ICBV))
for (e in 1:length(Base$ICBV)) {
if (Base$ICBV[e]>=1) {Base$FE[e]=((Base$ICBV[e]-1)*Base$FA[e])+1}else{
if (Base$ICBV[e]<1) {Base$FE[e]=Base$ICBV[e]}else{
if (Base$ICBV[e]==0){Base$FE[e]=0}}}}
#5.
Base$VDC_inicial=Base$VDP*Base$FE
minimo <- function(x){                 #Funcion minimo sin ceros
min_mun <<- min(x[which(x>0)])
return(min_mun)
}
Base$min_vdc = with(Base, ave(Base$VDC_inicial,Base$`Codigo Dane Mun`, FUN = minimo))  #Halla el min de VDC por municipio
Base$min_vdc[is.infinite(Base$min_vdc)] <- 0
Base$VDC = rep(0,length(Base$VDC_inicial))
for (w in 1:length(Base$VDP)) {
if (Base$Nueva[w]==1){Base$VDC[w]=Base$min_vdc[w]}else{
if (Base$VDP[w]==0 & Base$Nueva[w]==0 ) {Base$VDC[w]=Base$VDC_inicial[w]}else{
if (Base$VDP[w]!=0) {Base$VDC[w]=Base$VDC_inicial[w]}}}}
#####
#### Volumen Distribuido por Almacenamiento - VDA ####
Base$Xcompras_min = rep(0,length(Base$Xcompras))
Base$Xcompras_min = with(Base, ave(Base$Xcompras, Base$`Codigo Dane Mun`, FUN = minimo))  #Halla el min de compras por municipio
Base$Xcompras_min[is.infinite(Base$Xcompras_min)] <- 0
Base$Compras_final = rep(0,length(Base$Xcompras))
for (q in 1:length(Base$Nueva)) {
if (Base$Nueva[q]==1) {Base$Compras_final[q]=Base$Xcompras_min[q]}else{
if (Base$Nueva[q]==0) {Base$Compras_final[q]=Base$Xcompras[q]}}}
#1.
Base$IRI = (Base$Almacenamiento*30)/Base$Compras_final
Base$IRI[!is.finite(Base$IRI)] <-0
#2.
Base$FAM = Base$IRI/Base$ICO
#3.
Base$VDA = rep(0,length(Base$Almacenamiento))
for (r in 1:length(Base$FAM)) {
if (Base$FAM[r]<=1) {Base$VDA[r]=Base$Almacenamiento[r]}else{
if (Base$FAM[r]>1) {Base$VDA[r]=(Base$Almacenamiento[r]/Base$IRI[r])*Base$ICO[r] } }}
#####
#### Volumenes maximos distribuidos - VMD ####
#1.
Base$VMT = rep(0,length(Base$Sicom))
for (j in 1:length(Base$Xcompras)) {
if (Base$Nueva[j]==1 ) {Base$VMT[j]=0.8*Base$VDC[j] + 0.2*Base$VDA[j]}else{
if (Base$Xcompras[j]==0 & Base$Nueva[j]==0 ) {Base$VMT[j]=0}else{
if (Base$Xcompras[j]!=0) {Base$VMT[j]=0.8*Base$VDC[j] + 0.2*Base$VDA[j] }}}}
#2.
Base$VMTA=with(Base, ave(Base$VMT, Base$`Codigo Dane Mun`, FUN = sum))
#3.
Base$partEDS = Base$VMT/Base$VMTA
Base$partEDS[is.na(Base$partEDS)]<-0
#4.
Base$VMD_inicial=Base$VMM*Base$partEDS
#####
#### Iteracion Limite Superior ####
LS=200000
###Iteracion 1
Base$eds_ls_1 = rep(0, length(Base$Sicom))  # Indicador EDS que superan LS
for (e in 1:length(Base$VMD_inicial)) {
if (Base$VMD_inicial[e]>LS) {Base$eds_ls_1[e]=1}}
Base$VR_eds_1 = (Base$VMD_inicial*Base$eds_ls_1)-(LS*Base$eds_ls_1)
Base$VR_mun_1 = with(Base,ave(Base$VR_eds_1,Base$`Codigo Dane Mun`,FUN = sum))  #Volumen a redistribuir por municipio
Base$eds_nols_1= rep(0,length(Base$Sicom))  # Indicador EDS que NO superan LS
for (e in 1:length(Base$VMD_inicial)) {
if (Base$VMD_inicial[e]<LS) {Base$eds_nols_1[e]=1}}
Base$Vol_eds_nols_1=Base$VMD_inicial*Base$eds_nols_1
Base$Vol_mun_nols_1=with(Base,ave(Base$Vol_eds_nols_1,Base$`Codigo Dane Mun`, FUN = sum))  #Volumen dentro de LS por municipio
Base$part_eds_nols_1=(Base$VMD_inicial*Base$eds_nols_1)/Base$Vol_mun_nols_1
Base$part_eds_nols_1[is.na(Base$part_eds_nols_1)]<-0
Base$VMD_2=rep(0,length(Base$Sicom))
for (q in 1:length(Base$VMD_inicial)) {
if (Base$VMD_inicial[q]>=LS) {Base$VMD_2[q]=LS}else{
if (Base$VMD_inicial[q]<LS) {Base$VMD_2[q]=Base$VMD_inicial[q]+(Base$VR_mun_1[q]*Base$part_eds_nols_1[q])}}}
###Iteracion 2
Base$eds_ls_2 = rep(0, length(Base$Sicom))  # Indicador EDS que superan LS
for (e in 1:length(Base$VMD_2)) {
if (Base$VMD_2[e]>LS) {Base$eds_ls_2[e]=1}}
Base$VR_eds_2 = (Base$VMD_2*Base$eds_ls_2)-(LS*Base$eds_ls_2)
Base$VR_mun_2 = with(Base,ave(Base$VR_eds_2,Base$`Codigo Dane Mun`,FUN = sum))  #Volumen a redistribuir por municipio
Base$eds_nols_2= rep(0,length(Base$Sicom))  # Indicador EDS que NO superan LS
for (e in 1:length(Base$VMD_2)) {
if (Base$VMD_2[e]<LS) {Base$eds_nols_2[e]=1}}
Base$Vol_eds_nols_2=Base$VMD_2*Base$eds_nols_2
Base$Vol_mun_nols_2=with(Base,ave(Base$Vol_eds_nols_2,Base$`Codigo Dane Mun`, FUN = sum))  #Volumen dentro de LS por municipio
Base$part_eds_nols_2=(Base$VMD_2*Base$eds_nols_2)/Base$Vol_mun_nols_2
Base$part_eds_nols_2[is.na(Base$part_eds_nols_2)]<-0
Base$VMD_3=rep(0,length(Base$Sicom))
for (q in 1:length(Base$VMD_2)) {
if (Base$VMD_2[q]>=LS) {Base$VMD_3[q]=LS}else{
if (Base$VMD_2[q]<LS) {Base$VMD_3[q]=Base$VMD_2[q]+(Base$VR_mun_2[q]*Base$part_eds_nols_2[q])}}}
###Iteracion 3
Base$eds_ls_3 = rep(0, length(Base$Sicom))  # Indicador EDS que superan LS
for (e in 1:length(Base$VMD_3)) {
if (Base$VMD_3[e]>LS) {Base$eds_ls_3[e]=1}}
Base$VR_eds_3 = (Base$VMD_3*Base$eds_ls_3)-(LS*Base$eds_ls_3)
Base$VR_mun_3 = with(Base,ave(Base$VR_eds_3,Base$`Codigo Dane Mun`,FUN = sum))  #Volumen a redistribuir por municipio
Base$eds_nols_3= rep(0,length(Base$Sicom))  # Indicador EDS que NO superan LS
for (e in 1:length(Base$VMD_3)) {
if (Base$VMD_3[e]<LS) {Base$eds_nols_3[e]=1}}
Base$Vol_eds_nols_3=Base$VMD_3*Base$eds_nols_3
Base$Vol_mun_nols_3=with(Base,ave(Base$Vol_eds_nols_3,Base$`Codigo Dane Mun`, FUN = sum))  #Volumen dentro de LS por municipio
Base$part_eds_nols_3=(Base$VMD_3*Base$eds_nols_3)/Base$Vol_mun_nols_3
Base$part_eds_nols_3[is.na(Base$part_eds_nols_3)]<-0
Base$VMD_4=rep(0,length(Base$Sicom))
for (q in 1:length(Base$VMD_3)) {
if (Base$VMD_3[q]>=LS) {Base$VMD_4[q]=LS}else{
if (Base$VMD_3[q]<LS) {Base$VMD_4[q]=Base$VMD_3[q]+(Base$VR_mun_3[q]*Base$part_eds_nols_3[q])}}}
###Iteracion 4
Base$eds_ls_4 = rep(0, length(Base$Sicom))  # Indicador EDS que superan LS
for (e in 1:length(Base$VMD_4)) {
if (Base$VMD_4[e]>LS) {Base$eds_ls_4[e]=1}}
Base$VR_eds_4 = (Base$VMD_4*Base$eds_ls_4)-(LS*Base$eds_ls_4)
Base$VR_mun_4 = with(Base,ave(Base$VR_eds_4,Base$`Codigo Dane Mun`,FUN = sum))  #Volumen a redistribuir por municipio
Base$eds_nols_4= rep(0,length(Base$Sicom))  # Indicador EDS que NO superan LS
for (e in 1:length(Base$VMD_4)) {
if (Base$VMD_4[e]<LS) {Base$eds_nols_4[e]=1}}
Base$Vol_eds_nols_4=Base$VMD_4*Base$eds_nols_4
Base$Vol_mun_nols_4=with(Base,ave(Base$Vol_eds_nols_4,Base$`Codigo Dane Mun`, FUN = sum))  #Volumen dentro de LS por municipio
Base$part_eds_nols_4=(Base$VMD_4*Base$eds_nols_4)/Base$Vol_mun_nols_4
Base$part_eds_nols_4[is.na(Base$part_eds_nols_4)]<-0
Base$VMD_5=rep(0,length(Base$Sicom))
for (q in 1:length(Base$VMD_4)) {
if (Base$VMD_4[q]>=LS) {Base$VMD_5[q]=LS}else{
if (Base$VMD_4[q]<LS) {Base$VMD_5[q]=Base$VMD_4[q]+(Base$VR_mun_4[q]*Base$part_eds_nols_4[q])}}}
max(Base$VMD_inicial)
max(Base$VMD_2)
max(Base$VMD_3)
max(Base$VMD_4)
max(Base$VMD_5)
